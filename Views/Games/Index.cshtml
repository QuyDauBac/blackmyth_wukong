@model WukongWeb.Models.ViewModels.GamesIndexViewModel
@{
    ViewBag.Title = "Catalogue";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

@functions {
    string Cover(WukongWeb.Models.Game game)
    {
        return string.IsNullOrWhiteSpace(game.CoverImage)
            ? Url.Content("~/assets/img_MbWeb_bg_introduce_1.871099bb.jpg")
            : Url.Content("~/" + game.CoverImage);
    }
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
    <div>
        <p class="eyebrow text-uppercase small text-muted mb-1">Explore the catalogue</p>
        <h1 class="h2 mb-0">Games &amp; <em class="text-warning">editions</em></h1>
    </div>
    <span class="text-muted small">@Model.Games.TotalCount game(s) found</span>
</div>

<form method="get" action="@Url.Action("Index", "Games")" class="card p-3 p-md-4 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="q">Search</label>
            <input class="form-control" id="q" name="q" value="@Model.Query" placeholder="Title or description">
        </div>
        <div class="col-md-3">
            <label class="form-label" for="categoryId">Category</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="sort">Sort</label>
            <select class="form-select" id="sort" name="sort">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Title A–Z</option>
                <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                <option value="price" selected="@(Model.Sort == "price")">Price: low to high</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Price: high to low</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-warning flex-grow-1">Filter</button>
            <a class="btn btn-outline-light" href="@Url.Action("Index", "Games")">Reset</a>
        </div>
    </div>
</form>

@if (!Model.Games.Items.Any())
{
    <div class="card p-4 text-center">
        <p class="mb-2">No games match those filters.</p>
        <a class="btn btn-warning btn-sm" href="@Url.Action("Index", "Games")">Show everything</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var game in Model.Games.Items)
        {
            <div class="col-sm-6 col-lg-4">
                <article class="card game-card">
                    <a href="@Url.Action("Details", "Games", new { id = game.GameId })">
                        <img src="@Cover(game)" alt="@game.Title cover art" loading="lazy">
                    </a>
                    <div class="card-body">
                        <span class="badge bg-secondary align-self-start">@game.Category.Name</span>
                        <h2 class="card-title mb-0">
                            <a class="text-reset text-decoration-none" href="@Url.Action("Details", "Games", new { id = game.GameId })">@game.Title</a>
                        </h2>
                        <p class="text-muted small mb-0">@game.Developer</p>
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                            <span class="price-tag">₫@game.BasePrice.ToString("N0", culture)</span>
                            <a class="btn btn-outline-light btn-sm" href="@Url.Action("Details", "Games", new { id = game.GameId })">View</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    if (Model.Games.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Catalogue pages">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Games.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Index", "Games", new { q = Model.Query, categoryId = Model.CategoryId, sort = Model.Sort, page = Model.Games.Page - 1 })">Previous</a>
                </li>
                @for (var page = 1; page <= Model.Games.TotalPages; page++)
                {
                    <li class="page-item @(page == Model.Games.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Games", new { q = Model.Query, categoryId = Model.CategoryId, sort = Model.Sort, page = page })">@page</a>
                    </li>
                }
                <li class="page-item @(Model.Games.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Index", "Games", new { q = Model.Query, categoryId = Model.CategoryId, sort = Model.Sort, page = Model.Games.Page + 1 })">Next</a>
                </li>
            </ul>
        </nav>
    }
}
