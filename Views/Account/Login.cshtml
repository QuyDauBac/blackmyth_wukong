@model WukongWeb.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Log in";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="auth-wrap">
    <div class="auth-card">
        <p class="eyebrow text-uppercase small text-muted mb-2">Your journey</p>
        <h1>Welcome, <em>Destined One.</em></h1>
        <p class="text-muted mt-2">Sign in to buy the game, write reviews and keep a wishlist.</p>

        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { @class = "mt-4", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "email", placeholder = "name@example.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password", placeholder = "At least 10 characters" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn btn-warning w-100">Log in</button>
        }

        <p class="mt-3 mb-0 small text-muted">
            New here? <a href="@Url.Action("Register", "Account", new { returnUrl = Model.ReturnUrl })">Create an account</a>.
        </p>
        <p class="mt-2 mb-0 small text-muted">
            Demo account: <code>admin@wukong.local</code> / <code>Admin@12345</code>
        </p>
    </div>
</div>

@section scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
