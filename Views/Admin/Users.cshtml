@model WukongWeb.Models.ViewModels.AdminUsersViewModel
@{
    ViewBag.Title = "Accounts";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
    <div>
        <p class="eyebrow text-uppercase small text-muted mb-1">Access management</p>
        <h1 class="h3 mb-0">Accounts</h1>
    </div>
    <a class="btn btn-warning btn-sm" href="@Url.Action("UserCreate", "Admin")">New account</a>
</div>

<form method="get" action="@Url.Action("Users", "Admin")" class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-4">
            <label class="form-label" for="q">Search</label>
            <input class="form-control" id="q" name="q" value="@Model.Query" placeholder="Email or display name">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-warning">Search</button>
            <a class="btn btn-outline-light" href="@Url.Action("Users", "Admin")">Reset</a>
        </div>
    </div>
</form>

<div class="card p-3 p-md-4">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr><th>Display name</th><th>Email</th><th>Role</th><th>Status</th><th>Created</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users.Items)
                {
                    <tr>
                        <td>@user.DisplayName</td>
                        <td>@user.Email</td>
                        <td><span class="badge @(user.Role.RoleName == "Admin" ? "bg-warning text-dark" : "bg-secondary")">@user.Role.RoleName</span></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Disabled</span>
                            }
                        </td>
                        <td>@user.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-light btn-sm" href="@Url.Action("UserEdit", "Admin", new { id = user.UserId })">Edit</a>
                            @using (Html.BeginForm("UserToggleActive", "Admin", new { id = user.UserId }, FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning btn-sm">@(user.IsActive ? "Disable" : "Enable")</button>
                            }
                            @using (Html.BeginForm("UserDelete", "Admin", new { id = user.UserId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Delete or deactivate this account?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Users.Items.Any())
    {
        <p class="text-muted mb-0 mt-3">No accounts match the search.</p>
    }

    @if (Model.Users.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Account pages">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Users.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Users", "Admin", new { q = Model.Query, page = Model.Users.Page - 1 })">Previous</a>
                </li>
                @for (var page = 1; page <= Model.Users.TotalPages; page++)
                {
                    <li class="page-item @(page == Model.Users.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Users", "Admin", new { q = Model.Query, page = page })">@page</a>
                    </li>
                }
                <li class="page-item @(Model.Users.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Users", "Admin", new { q = Model.Query, page = Model.Users.Page + 1 })">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
