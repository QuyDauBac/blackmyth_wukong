@model System.Collections.Generic.IList<WukongWeb.Models.Review>
@{
    ViewBag.Title = "Reviews";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var query = (string)ViewBag.Query;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
    <div>
        <p class="eyebrow text-uppercase small text-muted mb-1">Moderation</p>
        <h1 class="h3 mb-0">Reviews</h1>
    </div>
    <span class="text-muted small">@totalCount review(s)</span>
</div>

<form method="get" action="@Url.Action("Reviews", "Admin")" class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-4">
            <label class="form-label" for="q">Search</label>
            <input class="form-control" id="q" name="q" value="@query" placeholder="Game, customer or comment">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-warning">Search</button>
            <a class="btn btn-outline-light" href="@Url.Action("Reviews", "Admin")">Reset</a>
        </div>
    </div>
</form>

<div class="card p-3 p-md-4">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr><th>Game</th><th>Customer</th><th>Rating</th><th>Comment</th><th>Date</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                    <tr>
                        <td>@review.Game.Title</td>
                        <td>@review.User.DisplayName</td>
                        <td class="stars">@(new string('\u2605', review.Rating))@(new string('\u2606', 5 - review.Rating))</td>
                        <td class="text-muted">@review.Comment</td>
                        <td>@review.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            @using (Html.BeginForm("ReviewDelete", "Admin", new { id = review.ReviewId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Delete this review?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mb-0 mt-3">No reviews match the search.</p>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Review pages">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(page > 1 ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Reviews", "Admin", new { q = query, page = page - 1 })">Previous</a>
                </li>
                @for (var p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Reviews", "Admin", new { q = query, page = p })">@p</a>
                    </li>
                }
                <li class="page-item @(page < totalPages ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Reviews", "Admin", new { q = query, page = page + 1 })">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
