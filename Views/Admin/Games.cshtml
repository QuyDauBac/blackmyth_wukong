@model WukongWeb.Models.ViewModels.AdminGamesViewModel
@{
    ViewBag.Title = "Games";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
    <div>
        <p class="eyebrow text-uppercase small text-muted mb-1">Catalogue management</p>
        <h1 class="h3 mb-0">Games</h1>
    </div>
    <a class="btn btn-warning btn-sm" href="@Url.Action("GameCreate", "Admin")">New game</a>
</div>

<form method="get" action="@Url.Action("Games", "Admin")" class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-4">
            <label class="form-label" for="q">Search</label>
            <input class="form-control" id="q" name="q" value="@Model.Query" placeholder="Title or slug">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-warning">Search</button>
            <a class="btn btn-outline-light" href="@Url.Action("Games", "Admin")">Reset</a>
        </div>
    </div>
</form>

<div class="card p-3 p-md-4">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr><th>Title</th><th>Slug</th><th>Category</th><th class="text-end">Base price</th><th>Active</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var game in Model.Games.Items)
                {
                    <tr>
                        <td>@game.Title</td>
                        <td><code>@game.Slug</code></td>
                        <td>@game.Category.Name</td>
                        <td class="text-end">₫@game.BasePrice.ToString("N0", culture)</td>
                        <td>
                            @if (game.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hidden</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-light btn-sm" href="@Url.Action("GameEdit", "Admin", new { id = game.GameId })">Edit</a>
                            @using (Html.BeginForm("GameDelete", "Admin", new { id = game.GameId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Delete or deactivate this game?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Games.Items.Any())
    {
        <p class="text-muted mb-0 mt-3">No games match the search.</p>
    }

    @if (Model.Games.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Game pages">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Games.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Games", "Admin", new { q = Model.Query, page = Model.Games.Page - 1 })">Previous</a>
                </li>
                @for (var page = 1; page <= Model.Games.TotalPages; page++)
                {
                    <li class="page-item @(page == Model.Games.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Games", "Admin", new { q = Model.Query, page = page })">@page</a>
                    </li>
                }
                <li class="page-item @(Model.Games.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Games", "Admin", new { q = Model.Query, page = Model.Games.Page + 1 })">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
