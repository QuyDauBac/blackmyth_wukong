          <ScalarProperty Name="Description" ColumnName="Description" />
          <ScalarProperty Name="CategoryId" ColumnName="CategoryId" />
          <ScalarProperty Name="Developer" ColumnName="Developer" />
          <ScalarProperty Name="Publisher" ColumnName="Publisher" />
          <ScalarProperty Name="ReleaseDate" ColumnName="ReleaseDate" />
          <ScalarProperty Name="BasePrice" ColumnName="BasePrice" />
          <ScalarProperty Name="CoverImage" ColumnName="CoverImage" />
          <ScalarProperty Name="IsActive" ColumnName="IsActive" />
          <ScalarProperty Name="CreatedAtUtc" ColumnName="CreatedAtUtc" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="MediaAssets">
      <EntityTypeMapping TypeName="WukongWeb.Models.MediaAsset">
        <MappingFragment StoreEntitySet="MediaAssets">
          <ScalarProperty Name="MediaId" ColumnName="MediaId" />
          <ScalarProperty Name="GameId" ColumnName="GameId" />
